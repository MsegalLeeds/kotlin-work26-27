{# Task 6.6 #}
    {% extends "base.peb" %}

{% block main %}
<h1>Albums</h1>

<table>
    <thead>
        <tr>
            <th scope="col">Artist name</th>
            <th scope="col">Album title</th>
            <th scope="col">Year of release</th>
        </tr>
    </thead>
    <tbody>
        {% for album in albums %}
        <tr>
            <td>{{ album.artist.name }}</td>
            <td>{{ album.title }}</td>
            <td>{{ album.year }}</td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% endblock %}